{
  "name": "dsh-memory",
  "version": "0.3.0",
  "private": true,
  "description": "Budgeted user memory for DeepSeek Harness: USER.md / MEMORY.md injected as a session-frozen system-prompt block plus an append-only MEMORY UPDATE snapshot, so edits stop busting the prefix cache.",
  "license": "MIT",
  "author": {
    "name": "supakiat-debug",
    "email": "supakiat@gmail.com",
    "url": "https://github.com/supakiat-debug"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/supakiat-debug/dsh-memory.git"
  },
  "homepage": "https://github.com/supakiat-debug/dsh-memory#readme",
  "bugs": {
    "url": "https://github.com/supakiat-debug/dsh-memory/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "bundle",
    "memory",
    "user-profile",
    "prompt-cache",
    "llama-cpp"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "type": "module",
  "scripts": {
    "test": "node --import ./test-register.mjs test-smoke.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "locale/*.json",
    "README.md",
    "README.th.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "meta": {
    "title": "User Memory",
    "description": "Learns preferences and tastes from chat history into USER.md / MEMORY.md and injects them into every session."
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
